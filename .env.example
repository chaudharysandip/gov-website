# WMS, the source of the tenant content the canvas renders. The studio reads the
# same endpoints the live website does, through the shared service layer in
# `@edn/site-themes/services`.
NEXT_PUBLIC_API_BASE_URL=https://wms.edigitalnepal.com
NEXT_PUBLIC_API_URL=https://wms.edigitalnepal.com/wms/api/v2
NEXT_API_TOKEN=

# Which tenant a request to localhost resolves to. The studio only uses this to
# pick the API base for its own host; the site being edited supplies its own
# domain from the website record.
# NEXT_PUBLIC_DEV_SITE_DOMAIN=omegacollege.edu.np
